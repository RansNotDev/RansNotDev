# Server-only AI credentials. Copy this file to `.env` and fill in real values.
# Never prefix secrets with VITE_ or expose them to browser code.
# In production, configure these in Vercel > Project Settings > Environment Variables.
# The chat API tries providers in order and uses the first one that responds.

# Order the chat API falls back through:
# xAI/Grok -> Kimi -> OpenRouter -> Gemini -> Mistral -> DeepInfra -> Hugging Face

# 1. xAI / Grok
XAI_API_KEY=your_server_side_xai_key
XAI_MODEL=grok-2-latest

# 2. Kimi / Moonshot
KIMI_API_KEY=your_server_side_kimi_key
KIMI_MODEL=moonshot-v1-8k

# 3. OpenRouter
OPENROUTER_API_KEY=your_server_side_openrouter_key
OPENROUTER_MODEL=openrouter/free

# 4. Gemini
GEMINI_API_KEY=your_server_side_gemini_key
GEMINI_MODEL=gemini-flash-latest

# 5. Mistral
MISTRAL_API_KEY=your_server_side_mistral_key
MISTRAL_MODEL=open-mistral-7b

# 6. Groq (High-Speed Inference)
GROQ_API_KEY=your_server_side_groq_key
GROQ_MODEL=llama-3.1-8b-instant

# 7. DeepInfra
DEEPINFRA_API_KEY=your_server_side_deepinfra_key
DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# 7. Hugging Face
HF_API_KEY=your_server_side_huggingface_key
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ──────────────────────────────────────────────────────────────
# Visitor counter (MongoDB Atlas — free M0 tier)
# Powers the "online now" + "total visits" badge in the nav bar.
# Create a free cluster at https://www.mongodb.com/cloud/atlas, add a
# database user + network access (0.0.0.0/0 for Vercel), then paste the
# connection string below (and into Vercel env vars). Replace <password>
# with your database user's real password.
# If MONGODB_URI is omitted, the badge simply hides — the site still works.
# ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio

# ──────────────────────────────────────────────────────────────
# Contact form (Resend — free tier)
# Sends the "New Message" form straight to Rany's inbox.
# Get a free API key at https://resend.com (Dashboard > API Keys),
# then paste it below (and into Vercel env vars). Without it, the form
# returns a friendly "not configured" error instead of sending.
#
# CONTACT_FROM: with no custom domain, use Resend's shared sender
#   "onboarding@resend.dev". The visitor's address is set as reply-to,
#   so you reply to them directly. Set a verified-domain sender here
#   once you have one. CONTACT_TO overrides the default recipient.
# ──────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
CONTACT_FROM=Portfolio Contact <onboarding@resend.dev>
CONTACT_TO=ranyboytemplado001@gmail.com