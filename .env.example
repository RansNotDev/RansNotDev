# Server-only AI credentials. Copy this file to `.env` and fill in real values.
# Never prefix secrets with VITE_ or expose them to browser code.
# In production, configure these in Vercel > Project Settings > Environment Variables.
# The chat API tries providers in order and uses the first one that responds.

# Order the chat API falls back through:
# xAI/Grok -> Kimi -> OpenRouter -> Gemini -> Mistral -> DeepInfra -> Hugging Face

# 1. xAI / Grok
XAI_API_KEY=your_server_side_xai_key
XAI_MODEL=grok-2-latest

# 2. Kimi / Moonshot
KIMI_API_KEY=your_server_side_kimi_key
KIMI_MODEL=moonshot-v1-8k

# 3. OpenRouter
OPENROUTER_API_KEY=your_server_side_openrouter_key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# 4. Gemini
GEMINI_API_KEY=your_server_side_gemini_key
GEMINI_MODEL=gemini-flash-latest

# 5. Mistral
MISTRAL_API_KEY=your_server_side_mistral_key
MISTRAL_MODEL=mistral-small-latest

# 6. DeepInfra
DEEPINFRA_API_KEY=your_server_side_deepinfra_key
DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# 7. Hugging Face
HF_API_KEY=your_server_side_huggingface_key
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
