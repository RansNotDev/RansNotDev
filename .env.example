# Server-only AI credentials. Never prefix secrets with VITE_ or expose them to browser code.
# Configure these in Vercel Project Settings > Environment Variables.

# Groq
GROQ_API_KEY=your_server_side_groq_key
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter
OPENROUTER_API_KEY=your_server_side_openrouter_key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Gemini
GEMINI_API_KEY=your_server_side_gemini_key
GEMINI_MODEL=gemini-2.0-flash

# Cerebras
CEREBRAS_API_KEY=your_server_side_cerebras_key
CEREBRAS_MODEL=llama-3.3-70b

# Mistral
MISTRAL_API_KEY=your_server_side_mistral_key
MISTRAL_MODEL=mistral-small-latest

# Together
TOGETHER_API_KEY=your_server_side_together_key
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# DeepInfra
DEEPINFRA_API_KEY=your_server_side_deepinfra_key
DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Fireworks
FIREWORKS_API_KEY=your_server_side_fireworks_key
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct

# Hugging Face
HF_API_KEY=your_server_side_huggingface_key
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
