# ═══════════════════════════════════════════════════════════════════════════════
# AI Provider API Keys & Models
# Copy this file to .env and fill in your keys.
# The chatbot will try providers in order — if one is exhausted or fails,
# it automatically falls through to the next available provider.
# Models are optional — defaults are provided if not set.
# ═══════════════════════════════════════════════════════════════════════════════

# 1. Groq (free tier, fast inference)
VITE_GROQ_API_KEY=your_groq_key_here
VITE_GROQ_MODEL=llama-3.1-8b-instant

# 2. Google Gemini
VITE_GEMINI_API_KEY=your_gemini_key_here
VITE_GEMINI_MODEL=gemini-1.5-flash

# 3. OpenRouter (aggregator — access to many models)
VITE_OPENROUTER_API_KEY=your_openrouter_key_here
VITE_OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# 4. Cerebras (fast inference)
VITE_CEREBRAS_API_KEY=your_cerebras_key_here
VITE_CEREBRAS_MODEL=llama3.1-8b

# 5. Mistral AI
VITE_MISTRAL_API_KEY=your_mistral_key_here
VITE_MISTRAL_MODEL=mistral-small-latest

# 6. Together AI
VITE_TOGETHER_API_KEY=your_together_key_here
VITE_TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# 7. DeepInfra
VITE_DEEPINFRA_API_KEY=your_deepinfra_key_here
VITE_DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# 8. Fireworks AI
VITE_FIREWORKS_API_KEY=your_fireworks_key_here
VITE_FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct

# 9. Hugging Face (token-based)
VITE_HUGGINGFACE_TOKEN=your_hf_token_here
VITE_HUGGINGFACE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
